{
  "name": "airbag",
  "version": "0.1.0",
  "private": true,
  "description": "Airbag: protects a cirBTC-backed USDC loan on Arc using live odds from Gemini's prediction market.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.20.2",
    "@circle-fin/app-kit": "^1.22.0",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "sim": "tsx --env-file-if-exists=.env src/server.ts --sim",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts --sim",
    "test": "node src/brain.test.mjs && node --test \"test/**/*.test.mjs\"",
    "typecheck": "tsc -p .",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "explore": "tsx scripts/explore.ts",
    "preview": "tsx scripts/preview.ts",
    "balances": "tsx --env-file=.env scripts/balances.ts",
    "loan:open": "tsx --env-file=.env scripts/open-loan.ts",
    "loan:show": "tsx --env-file=.env scripts/show.ts",
    "roundtrip": "tsx --env-file=.env scripts/roundtrip.ts",
    "savings:deposit": "tsx --env-file=.env scripts/deposit.ts",
    "webhook:register": "tsx --env-file=.env scripts/register-webhook.ts",
    "odds": "node scripts/odds.mjs",
    "replay": "node replay/fetch-candles.mjs && node replay/replay.mjs",
    "replay:run": "node replay/replay.mjs"
  }
}
