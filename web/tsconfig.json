{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/*"], "@brain": ["../src/brain.d.mts"], "@hedge": ["../src/hedge.d.mts"], "@history": ["../src/market-history.d.mts"], "@live": ["../src/gemini-live.d.mts"], "@crash": ["../src/crash-test.d.mts"] },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
