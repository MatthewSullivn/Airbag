# The built page (from web/, see AGENTS.md "The page"): generated files. Git must not change their line
# endings, and they should stay out of diffs and language statistics.
public/assets/** -text linguist-generated=true
public/build.json -text linguist-generated=true
public/index.html -text linguist-generated=true
public/app/index.html -text linguist-generated=true

# The two page templates are copied into the built pages as they are, line endings included. Keep them LF on
# every machine, or a rebuild on Windows would show the built pages as changed.
web/index.html text eol=lf
web/app/index.html text eol=lf
