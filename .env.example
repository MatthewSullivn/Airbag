# Airbag settings. Copy to .env and fill in. NEVER commit .env.
# `npm run wallet:new` makes .env for you with a fresh testnet-only wallet.

# ---------- bot wallet (Arc Testnet only, never a wallet with real money) ----------
PRIVATE_KEY=
# The address of PRIVATE_KEY. Not secret. Paste it into https://faucet.circle.com
BOT_ADDRESS=

# ---------- the rule ----------
# Act when the odds of losing the bitcoin go over this. 0.05 = 5%.
USER_LIMIT=0.05
# Most USDC the bot may move in 24 hours (repays + give-backs), enforced on the server.
DAILY_CAP_USDC=25
# How often the timer wakes the bot, in seconds.
TICK_SECONDS=5
# USDC always kept in the wallet to pay Arc gas (gas is paid in USDC).
GAS_RESERVE_USDC=0.5
# true = read, decide and log, but never send a transaction.
DRY_RUN=false
# real = value cirBTC at Gemini's live BTC price (default; the testnet oracle is fixed at $75,000).
# oracle = use the lending market's own price.
PRICE_SOURCE=real
# Demo buttons: "Push it to the edge" borrows up to this health (capped by Borrow Kit's max);
# "Reset" repays from the wallet back to this health.
PUSH_HEALTH=1.06
RESET_HEALTH=1.5

# ---------- Gemini odds (public API, no key) ----------
# Comma separated event tickers. The first one is shown big; the bot uses the worse odds of all of them.
# Leave empty to auto-discover the active "BTC price on <date>" ladders.
GEMINI_TICKERS=BTC2611302200,BTC2611202200
# The bot also listens to Gemini's live feed (wss://ws.gemini.com, public, no key) and looks again the moment a
# bet's price moves, instead of up to 25 s later. false = only read every 20 s.
GEMINI_FEED=true
# Optional: the hedge as a real order on Gemini's TEST site (test money). Make a test account at
# https://exchange.sandbox.gemini.com, then a key with the Trader role under Settings > API.
# With both set, the bot buys the "No" contracts that cover a loan each time it saves it, and cancels them
# when it is calm again. The code can only reach the test site. Try it first with: npm run hedge:test
GEMINI_SANDBOX_KEY=
GEMINI_SANDBOX_SECRET=

# ---------- Arc / Circle kits ----------
ARC_RPC_URL=https://rpc.testnet.arc.io
# Leave empty to find the cirBTC/USDC Borrow Kit market automatically.
MARKET_ID=
# Morpho Blue contract on Arc Testnet. The bot reads the loan straight from it (Borrow Kit's API can lag).
MORPHO_ADDRESS=0x65f435eb4ff05f1481618694bc1ff7ee4680c0a4
# Leave empty to pick the best active USDC Earn Kit vault automatically.
VAULT_ADDRESS=
# Leave empty to find this wallet's open loan automatically.
LOAN_ID=
# Optional. Higher rate limits for Earn/Borrow calls. Server-side only.
CIRCLE_API_KEY=

# ---------- AirbagGuard (optional, see contracts/README.md) ----------
# true = the bot's saves and give-backs go through the guard contract, signed by GUARD_BOT_KEY.
# PRIVATE_KEY is then optional on the server: leave it out and the server holds no key that can take funds.
# (Without PRIVATE_KEY the dashboard's Push / Reset buttons can't sign; use `npm run demo:push` on your own machine.)
# `npm run guard:deploy` writes GUARD_ADDRESS and GUARD_BOT_KEY at the end of this file.
USE_GUARD=false
# true = also protect every wallet that turns protection on from the page (Connect wallet). Each of them creates
# its own guard for GUARD_BOT_KEY's address, and this server then watches all of them. Live mode only.
# Run it on ONE server per bot key: two servers with the same key would both act.
PROTECT=false

# ---------- server ----------
PORT=3000
# Public https URL of this server (needed for the Borrow Kit webhook), e.g. https://airbag.example.com
PUBLIC_URL=
# Shared secret for POST routes and demo buttons. Send as header x-airbag-key or ?key=
WEBHOOK_SECRET=
# Hosted simulator only: true = anyone can press Push / Reset / Limit without the key (Pause stays key-only).
# Ignored in live mode, so the live bot always needs WEBHOOK_SECRET. Used by render.yaml.
PUBLIC_DEMO=
